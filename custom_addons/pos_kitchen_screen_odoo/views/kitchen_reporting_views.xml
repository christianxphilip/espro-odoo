<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_line_pivot_kitchen" model="ir.ui.view">
        <field name="name">pos.order.line.pivot.kitchen</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Kitchen Performance Analysis" disable_linking="True">
                <field name="product_id" type="row"/>
                <field name="order_id" type="col"/>
                <field name="time_to_prepare" type="measure" operator="avg"/>
                <field name="qty" type="measure" operator="sum"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_order_line_graph_kitchen" model="ir.ui.view">
        <field name="name">pos.order.line.graph.kitchen</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <graph string="Kitchen Performance Analysis" type="bar">
                <field name="product_id" type="row"/>
                <field name="time_to_prepare" type="measure" operator="avg"/>
            </graph>
        </field>
    </record>

    <record id="view_pos_order_line_search_kitchen" model="ir.ui.view">
        <field name="name">pos.order.line.search.kitchen</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <search string="Kitchen Performance Analysis">
                <field name="product_id"/>
                <field name="order_id"/>
                <filter string="Completed" name="completed" domain="[('order_status', '=', 'ready')]"/>
                <filter string="Kitchen Items" name="kitchen" domain="[('is_cooking', '=', True)]"/>
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                    <filter string="Order" name="group_by_order" context="{'group_by':'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_kitchen_performance" model="ir.actions.act_window">
        <field name="name">Kitchen Performance Analysis</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('time_to_prepare', '>', 0)]</field>
        <field name="context">{'search_default_completed': 1}</field>
        <field name="search_view_id" ref="view_pos_order_line_search_kitchen"/>
    </record>

    <record id="action_pos_kitchen_performance_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_pos_order_line_pivot_kitchen"/>
        <field name="act_window_id" ref="action_pos_kitchen_performance"/>
    </record>

    <record id="action_pos_kitchen_performance_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_pos_order_line_graph_kitchen"/>
        <field name="act_window_id" ref="action_pos_kitchen_performance"/>
    </record>

    <menuitem id="menu_pos_kitchen_performance"
              name="Kitchen Performance"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_kitchen_performance"
              sequence="50"/>
</odoo>
