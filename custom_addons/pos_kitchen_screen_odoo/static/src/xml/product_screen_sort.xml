<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_kitchen_screen_odoo.ProductScreenSort" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//CategorySelector" position="after">
            <div class="pos-product-sort-controls d-flex p-2 bg-light gap-2 justify-content-end align-items-center border-bottom mb-3">
                <span class="text-muted small">Sort by: </span>
                <button class="btn btn-sm btn-outline-secondary" t-att-class="{'active btn-secondary text-white': this.state.sortBy === 'name'}" t-on-click="() => this.setSortBy('name')">Name</button>
                <button class="btn btn-sm btn-outline-secondary" t-att-class="{'active btn-secondary text-white': this.state.sortBy === 'favorites'}" t-on-click="() => this.setSortBy('favorites')"><i class="fa fa-star text-warning me-1"></i> Favorites</button>
                <button class="btn btn-sm btn-outline-secondary" t-att-class="{'active btn-secondary text-white': this.state.sortBy === 'most_ordered'}" t-on-click="() => this.setSortBy('most_ordered')"><i class="fa fa-fire text-danger me-1"></i> Most Ordered</button>
            </div>
        </xpath>
    </t>

</templates>
